// GestiOne — schema de donnees
//
// Regles structurantes :
//  * Toute donnee metier porte `companyId` : l'isolation multi-entreprises est
//    appliquee dans la couche serveur, jamais dans l'interface.
//  * Les montants sont des entiers BigInt exprimes dans la plus petite unite de
//    la devise (XOF : 1 = 1 franc, EUR : 1 = 1 centime). Aucun Float.
//  * Les journaux (StockMovement, AuditLog, CashMovement) ne sont jamais modifies :
//    une correction produit une nouvelle ecriture.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Referentiel global (partage par toutes les entreprises)
// ---------------------------------------------------------------------------

/// Devises supportees. `decimals` pilote la conversion montant <-> unite mineure.
model Currency {
  code           String    @id // ISO 4217 : XOF, XAF, GHS, NGN, EUR, USD...
  name           String
  symbol         String
  decimals       Int       @default(2)
  symbolPosition String    @default("after") // "before" | "after"
  companies      Company[]

  @@map("currencies")
}

// ---------------------------------------------------------------------------
// Entreprise et parametrage
// ---------------------------------------------------------------------------

model Company {
  id           String   @id @default(cuid())
  name         String
  legalName    String?
  slug         String   @unique
  logoUrl      String?
  addressLine  String?
  city         String?
  countryCode  String   @default("CI") // ISO 3166-1 alpha-2
  phone        String?
  email        String?
  website      String?
  taxNumber    String? // NIF / RCCM / numero de TVA selon le pays
  currencyCode String   @default("XOF")
  locale       String   @default("fr")
  timezone     String   @default("Africa/Abidjan")

  // Personnalisation des documents
  primaryColor    String  @default("#0F766E")
  invoicePrefix   String  @default("FAC")
  quotePrefix     String  @default("DEV")
  salePrefix      String  @default("VTE")
  purchasePrefix  String  @default("CMD")
  paymentPrefix   String  @default("PAY")
  documentFooter  String?
  paymentTerms    String?
  defaultDueDays  Int     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency          Currency           @relation(fields: [currencyCode], references: [code])
  memberships       Membership[]
  roles             Role[]
  locations         Location[]
  auditLogs         AuditLog[]
  documentSequences DocumentSequence[]
  partners          Partner[]
  categories        Category[]
  units             Unit[]
  products          Product[]
  stockLevels       StockLevel[]
  stockMovements    StockMovement[]

  @@index([currencyCode])
  @@map("companies")
}

/// Boutique, agence, depot, entrepot ou point de vente.
model Location {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  code        String
  kind        String   @default("SHOP") // SHOP | WAREHOUSE | AGENCY | POS
  addressLine String?
  city        String?
  phone       String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Identite, appartenance et permissions
// ---------------------------------------------------------------------------

/// Un compte utilisateur est global ; il accede a une ou plusieurs entreprises
/// via `Membership`. Le mot de passe est hashe avec scrypt (sel par utilisateur).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships    Membership[]
  sessions       Session[]
  auditLogs      AuditLog[]
  stockMovements StockMovement[]

  @@map("users")
}

/// Role portant une liste de permissions granulaires.
/// `companyId` nul = role systeme propose a toutes les entreprises.
model Role {
  id          String   @id @default(cuid())
  companyId   String?
  key         String // ADMIN | MANAGER | SALES | STOCK | CASHIER | personnalise
  name        String
  description String?
  permissions String[] // ex. ["sales.create", "customers.read"]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([companyId, key])
  @@index([companyId])
  @@map("roles")
}

/// Lien utilisateur <-> entreprise, porteur du role et du point de vente par defaut.
model Membership {
  id                String   @id @default(cuid())
  userId            String
  companyId         String
  roleId            String
  defaultLocationId String?
  isOwner           Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role            Role      @relation(fields: [roleId], references: [id])
  defaultLocation Location? @relation(fields: [defaultLocationId], references: [id], onDelete: SetNull)
  sessions        Session[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@map("memberships")
}

/// Session opaque : seul le hash SHA-256 du jeton est stocke.
/// Le jeton en clair ne vit que dans le cookie httpOnly du navigateur.
model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  membershipId String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Tracabilite
// ---------------------------------------------------------------------------

/// Journal append-only des operations sensibles.
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  action     String // LOGIN | CREATE | UPDATE | DELETE | PAYMENT | STOCK_MOVE | CANCEL | PERMISSION_CHANGE
  entityType String
  entityId   String?
  summary    String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@map("audit_logs")
}

/// Compteur de numerotation des documents, incremente dans la transaction
/// qui cree le document, ce qui rend les doublons impossibles.
model DocumentSequence {
  id           String   @id @default(cuid())
  companyId    String
  documentType String // INVOICE | QUOTE | SALE | PURCHASE | PAYMENT | RECEIPT
  period       String // "2026" ou "2026-04" selon le format choisi
  prefix       String
  nextValue    Int      @default(1)
  padding      Int      @default(5)
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType, period])
  @@index([companyId])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Phase 2 — referentiels
// ---------------------------------------------------------------------------

/// Tiers commercial : client ou fournisseur. Les deux partagent la meme forme
/// (coordonnees, encours, historique) ; seul le sens de la relation change, ce
/// qui evite de dupliquer la moitie du modele et des ecrans.
model Partner {
  id           String   @id @default(cuid())
  companyId    String
  kind         String // CUSTOMER | SUPPLIER
  code         String
  name         String
  companyName  String?
  phone        String?
  secondPhone  String?
  email        String?
  addressLine  String?
  city         String?
  countryCode  String?
  taxNumber    String?
  /// Plafond d'encours autorise, en unite mineure. 0 = pas de vente a credit.
  creditLimit  BigInt   @default(0)
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, kind, code])
  @@index([companyId, kind, isActive])
  @@index([companyId, name])
  @@index([companyId, phone])
  @@map("partners")
}

/// Categorie d'articles. `parentId` autorise une arborescence a plusieurs
/// niveaux (Boissons > Boissons gazeuses) sans table supplementaire.
model Category {
  id        String   @id @default(cuid())
  companyId String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, name, parentId])
  @@index([companyId])
  @@map("categories")
}

/// Unite de mesure. GestiOne en fournit un jeu de depart, et chaque entreprise
/// peut creer les siennes (regime, botte, casier, bidon de 20 L...).
model Unit {
  id        String   @id @default(cuid())
  companyId String
  name      String
  symbol    String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, symbol])
  @@index([companyId])
  @@map("units")
}

/// Article vendable : bien physique (suivi en stock) ou service (sans stock).
///
/// Les prix sont des entiers en unite mineure de la devise de l'entreprise.
/// La quantite en stock n'est **pas** stockee ici : elle depend du point de
/// vente et se deduit du journal des mouvements (phase 3).
model Product {
  id          String  @id @default(cuid())
  companyId   String
  kind        String  @default("GOOD") // GOOD | SERVICE
  name        String
  sku         String
  barcode     String?
  description String?
  categoryId  String?
  unitId      String?
  supplierId  String?
  imageUrl    String?

  /// Prix d'achat / de revient, utilise pour estimer la marge.
  costPrice      BigInt  @default(0)
  /// Prix de vente au detail.
  salePrice      BigInt  @default(0)
  /// Prix de gros, applique a partir de `wholesaleFrom` unites.
  wholesalePrice BigInt?
  wholesaleFrom  BigInt?
  /// Prix negocie pour certains clients, applique manuellement a la vente.
  specialPrice   BigInt?

  /// Seuil d'alerte de rupture, en milliemes d'unite.
  minStock  BigInt  @default(0)
  /// Un service n'est jamais suivi en stock.
  trackStock Boolean @default(true)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit           Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  supplier       Partner?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId, isActive])
  @@index([companyId, name])
  @@index([companyId, barcode])
  @@index([companyId, categoryId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Phase 3 — stock
// ---------------------------------------------------------------------------

/// Solde de stock d'un article dans un point de vente.
///
/// C'est une valeur **derivee** : elle doit toujours etre egale a la somme des
/// mouvements correspondants. Elle est maintenue dans la meme transaction que
/// chaque mouvement, et sert uniquement a eviter de reagreger le journal a
/// chaque affichage.
model StockLevel {
  id         String   @id @default(cuid())
  companyId  String
  productId  String
  locationId String
  /// Quantite en milliemes d'unite (voir src/lib/quantity.ts).
  quantity   BigInt   @default(0)
  updatedAt  DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([companyId, locationId])
  @@index([companyId, productId])
  @@map("stock_levels")
}

/// Journal des mouvements de stock. **Append-only.**
///
/// Aucun service ne modifie ni ne supprime une ligne : une correction produit un
/// nouveau mouvement de sens inverse. C'est ce qui rend l'historique opposable —
/// un stock qui se reecrit ne prouve rien.
model StockMovement {
  id         String @id @default(cuid())
  companyId  String
  productId  String
  locationId String

  /// IN | OUT | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT | INVENTORY
  kind String

  /// Variation signee, en milliemes d'unite : positive en entree, negative en sortie.
  quantity      BigInt
  /// Solde du point de vente apres application du mouvement, fige a l'ecriture.
  quantityAfter BigInt
  /// Cout unitaire d'entree, en unite mineure de la devise (valorisation).
  unitCost      BigInt?

  reason    String?
  reference String?
  /// Relie les deux ecritures d'un meme transfert entre points de vente.
  transferId String?
  userId    String?
  createdAt DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, productId, createdAt])
  @@index([companyId, locationId, createdAt])
  @@index([transferId])
  @@map("stock_movements")
}
