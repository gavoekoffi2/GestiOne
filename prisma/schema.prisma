// GestiOne — schema de donnees
//
// Regles structurantes :
//  * Toute donnee metier porte `companyId` : l'isolation multi-entreprises est
//    appliquee dans la couche serveur, jamais dans l'interface.
//  * Les montants sont des entiers BigInt exprimes dans la plus petite unite de
//    la devise (XOF : 1 = 1 franc, EUR : 1 = 1 centime). Aucun Float.
//  * Les journaux (StockMovement, AuditLog, CashMovement) ne sont jamais modifies :
//    une correction produit une nouvelle ecriture.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Referentiel global (partage par toutes les entreprises)
// ---------------------------------------------------------------------------

/// Devises supportees. `decimals` pilote la conversion montant <-> unite mineure.
model Currency {
  code           String    @id // ISO 4217 : XOF, XAF, GHS, NGN, EUR, USD...
  name           String
  symbol         String
  decimals       Int       @default(2)
  symbolPosition String    @default("after") // "before" | "after"
  companies      Company[]

  @@map("currencies")
}

// ---------------------------------------------------------------------------
// Entreprise et parametrage
// ---------------------------------------------------------------------------

model Company {
  id           String   @id @default(cuid())
  name         String
  legalName    String?
  slug         String   @unique
  logoUrl      String?
  addressLine  String?
  city         String?
  countryCode  String   @default("CI") // ISO 3166-1 alpha-2
  phone        String?
  email        String?
  website      String?
  taxNumber    String? // NIF / RCCM / numero de TVA selon le pays
  currencyCode String   @default("XOF")
  locale       String   @default("fr")
  timezone     String   @default("Africa/Abidjan")

  // Personnalisation des documents
  primaryColor    String  @default("#0F766E")
  invoicePrefix   String  @default("FAC")
  quotePrefix     String  @default("DEV")
  salePrefix      String  @default("VTE")
  purchasePrefix  String  @default("CMD")
  paymentPrefix   String  @default("PAY")
  documentFooter  String?
  paymentTerms    String?
  defaultDueDays  Int     @default(30)
  /// Format d'impression par defaut : "A4", "A5" ou "RECEIPT" (ticket 80 mm).
  documentFormat  String  @default("A4")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency          Currency           @relation(fields: [currencyCode], references: [code])
  memberships       Membership[]
  roles             Role[]
  locations         Location[]
  auditLogs         AuditLog[]
  documentSequences DocumentSequence[]
  partners          Partner[]
  categories        Category[]
  units             Unit[]
  products          Product[]
  stockLevels       StockLevel[]
  stockMovements    StockMovement[]
  paymentMethods    PaymentMethod[]
  taxRates          TaxRate[]
  quotes            Quote[]
  invoices          Invoice[]
  payments          Payment[]
  purchaseOrders    PurchaseOrder[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  cashSessions      CashSession[]
  cashMovements     CashMovement[]

  @@index([currencyCode])
  @@map("companies")
}

/// Boutique, agence, depot, entrepot ou point de vente.
model Location {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  code        String
  kind        String   @default("SHOP") // SHOP | WAREHOUSE | AGENCY | POS
  addressLine String?
  city        String?
  phone       String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  quotes         Quote[]
  invoices       Invoice[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]
  cashSessions   CashSession[]
  cashMovements  CashMovement[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Identite, appartenance et permissions
// ---------------------------------------------------------------------------

/// Un compte utilisateur est global ; il accede a une ou plusieurs entreprises
/// via `Membership`. Le mot de passe est hashe avec scrypt (sel par utilisateur).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships    Membership[]
  sessions       Session[]
  auditLogs      AuditLog[]
  stockMovements StockMovement[]
  quotes             Quote[]
  invoices           Invoice[]
  payments           Payment[]
  purchaseOrders     PurchaseOrder[]
  expenses           Expense[]
  cashMovements      CashMovement[]
  cashSessionsOpened CashSession[]   @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[]   @relation("CashSessionClosedBy")

  @@map("users")
}

/// Role portant une liste de permissions granulaires.
/// `companyId` nul = role systeme propose a toutes les entreprises.
model Role {
  id          String   @id @default(cuid())
  companyId   String?
  key         String // ADMIN | MANAGER | SALES | STOCK | CASHIER | personnalise
  name        String
  description String?
  permissions String[] // ex. ["sales.create", "customers.read"]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([companyId, key])
  @@index([companyId])
  @@map("roles")
}

/// Lien utilisateur <-> entreprise, porteur du role et du point de vente par defaut.
model Membership {
  id                String   @id @default(cuid())
  userId            String
  companyId         String
  roleId            String
  defaultLocationId String?
  isOwner           Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role            Role      @relation(fields: [roleId], references: [id])
  defaultLocation Location? @relation(fields: [defaultLocationId], references: [id], onDelete: SetNull)
  sessions        Session[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@map("memberships")
}

/// Session opaque : seul le hash SHA-256 du jeton est stocke.
/// Le jeton en clair ne vit que dans le cookie httpOnly du navigateur.
model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  membershipId String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Tracabilite
// ---------------------------------------------------------------------------

/// Journal append-only des operations sensibles.
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  action     String // LOGIN | CREATE | UPDATE | DELETE | PAYMENT | STOCK_MOVE | CANCEL | PERMISSION_CHANGE
  entityType String
  entityId   String?
  summary    String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@map("audit_logs")
}

/// Compteur de numerotation des documents, incremente dans la transaction
/// qui cree le document, ce qui rend les doublons impossibles.
model DocumentSequence {
  id           String   @id @default(cuid())
  companyId    String
  documentType String // INVOICE | QUOTE | SALE | PURCHASE | PAYMENT | RECEIPT
  period       String // "2026" ou "2026-04" selon le format choisi
  prefix       String
  nextValue    Int      @default(1)
  padding      Int      @default(5)
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType, period])
  @@index([companyId])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Phase 2 — referentiels
// ---------------------------------------------------------------------------

/// Tiers commercial : client ou fournisseur. Les deux partagent la meme forme
/// (coordonnees, encours, historique) ; seul le sens de la relation change, ce
/// qui evite de dupliquer la moitie du modele et des ecrans.
model Partner {
  id           String   @id @default(cuid())
  companyId    String
  kind         String // CUSTOMER | SUPPLIER
  code         String
  name         String
  companyName  String?
  phone        String?
  secondPhone  String?
  email        String?
  addressLine  String?
  city         String?
  countryCode  String?
  taxNumber    String?
  /// Plafond d'encours autorise, en unite mineure. 0 = pas de vente a credit.
  creditLimit  BigInt   @default(0)
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]
  quotes         Quote[]
  invoices       Invoice[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@unique([companyId, kind, code])
  @@index([companyId, kind, isActive])
  @@index([companyId, name])
  @@index([companyId, phone])
  @@map("partners")
}

/// Categorie d'articles. `parentId` autorise une arborescence a plusieurs
/// niveaux (Boissons > Boissons gazeuses) sans table supplementaire.
model Category {
  id        String   @id @default(cuid())
  companyId String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, name, parentId])
  @@index([companyId])
  @@map("categories")
}

/// Unite de mesure. GestiOne en fournit un jeu de depart, et chaque entreprise
/// peut creer les siennes (regime, botte, casier, bidon de 20 L...).
model Unit {
  id        String   @id @default(cuid())
  companyId String
  name      String
  symbol    String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, symbol])
  @@index([companyId])
  @@map("units")
}

/// Article vendable : bien physique (suivi en stock) ou service (sans stock).
///
/// Les prix sont des entiers en unite mineure de la devise de l'entreprise.
/// La quantite en stock n'est **pas** stockee ici : elle depend du point de
/// vente et se deduit du journal des mouvements (phase 3).
model Product {
  id          String  @id @default(cuid())
  companyId   String
  kind        String  @default("GOOD") // GOOD | SERVICE
  name        String
  sku         String
  barcode     String?
  description String?
  categoryId  String?
  unitId      String?
  supplierId  String?
  imageUrl    String?

  /// Prix d'achat / de revient, utilise pour estimer la marge.
  costPrice      BigInt  @default(0)
  /// Prix de vente au detail.
  salePrice      BigInt  @default(0)
  /// Prix de gros, applique a partir de `wholesaleFrom` unites.
  wholesalePrice BigInt?
  wholesaleFrom  BigInt?
  /// Prix negocie pour certains clients, applique manuellement a la vente.
  specialPrice   BigInt?

  /// Seuil d'alerte de rupture, en milliemes d'unite.
  minStock  BigInt  @default(0)
  /// Un service n'est jamais suivi en stock.
  trackStock Boolean @default(true)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit           Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  supplier       Partner?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  quoteLines         QuoteLine[]
  invoiceLines       InvoiceLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([companyId, sku])
  @@index([companyId, isActive])
  @@index([companyId, name])
  @@index([companyId, barcode])
  @@index([companyId, categoryId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Phase 3 — stock
// ---------------------------------------------------------------------------

/// Solde de stock d'un article dans un point de vente.
///
/// C'est une valeur **derivee** : elle doit toujours etre egale a la somme des
/// mouvements correspondants. Elle est maintenue dans la meme transaction que
/// chaque mouvement, et sert uniquement a eviter de reagreger le journal a
/// chaque affichage.
model StockLevel {
  id         String   @id @default(cuid())
  companyId  String
  productId  String
  locationId String
  /// Quantite en milliemes d'unite (voir src/lib/quantity.ts).
  quantity   BigInt   @default(0)
  updatedAt  DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([companyId, locationId])
  @@index([companyId, productId])
  @@map("stock_levels")
}

/// Journal des mouvements de stock. **Append-only.**
///
/// Aucun service ne modifie ni ne supprime une ligne : une correction produit un
/// nouveau mouvement de sens inverse. C'est ce qui rend l'historique opposable —
/// un stock qui se reecrit ne prouve rien.
model StockMovement {
  id         String @id @default(cuid())
  companyId  String
  productId  String
  locationId String

  /// IN | OUT | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT | INVENTORY
  kind String

  /// Variation signee, en milliemes d'unite : positive en entree, negative en sortie.
  quantity      BigInt
  /// Solde du point de vente apres application du mouvement, fige a l'ecriture.
  quantityAfter BigInt
  /// Cout unitaire d'entree, en unite mineure de la devise (valorisation).
  unitCost      BigInt?

  reason    String?
  reference String?
  /// Relie les deux ecritures d'un meme transfert entre points de vente.
  transferId String?
  userId    String?
  createdAt DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, productId, createdAt])
  @@index([companyId, locationId, createdAt])
  @@index([transferId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Phase 4 — ventes, devis, factures, paiements
// ---------------------------------------------------------------------------

/// Mode de reglement, configurable par entreprise.
///
/// GestiOne installe les modes courants (especes, Mobile Money, virement,
/// carte, cheque, credit) et l'entreprise ajoute les siens. `kind` reste un
/// marqueur technique : c'est lui qui indique si le reglement alimente la
/// caisse (`CASH`) ou s'il constitue une creance (`CREDIT`).
model PaymentMethod {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  /// CASH | MOBILE_MONEY | BANK_TRANSFER | CARD | CHEQUE | CREDIT | OTHER
  kind      String   @default("OTHER")
  /// Un reglement a credit ne solde pas la facture : il constate une creance.
  isCredit  Boolean  @default(false)
  /// Alimente le solde de caisse (phase 5).
  affectsCash Boolean @default(false)
  /// Une reference (numero de transaction Mobile Money, numero de cheque) est-elle exigee ?
  requiresReference Boolean @default(false)
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments Payment[]
  expenses Expense[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("payment_methods")
}

/// Taux de taxe applicable aux lignes de document (TVA et equivalents).
model TaxRate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  /// Taux en centiemes de point : 1800 = 18,00 %.
  rate      Int
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceLines       InvoiceLine[]
  quoteLines         QuoteLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("tax_rates")
}

/// Devis.
model Quote {
  id         String   @id @default(cuid())
  companyId  String
  number     String
  customerId String?
  locationId String?
  /// DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED | CONVERTED
  status     String   @default("DRAFT")
  issueDate  DateTime @default(now())
  validUntil DateTime?

  subtotal       BigInt @default(0)
  discountAmount BigInt @default(0)
  /// Remise globale en centiemes de point, quand elle a ete saisie en pourcentage.
  discountRate   Int?
  taxTotal       BigInt @default(0)
  total          BigInt @default(0)

  notes     String?
  terms     String?
  /// Facture issue de la conversion, le cas echeant.
  invoiceId String?  @unique
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Partner?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  location Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoice  Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  lines    QuoteLine[]

  @@unique([companyId, number])
  @@index([companyId, status, issueDate])
  @@index([companyId, customerId])
  @@map("quotes")
}

model QuoteLine {
  id          String @id @default(cuid())
  quoteId     String
  productId   String?
  /// Libelle fige a la creation : renommer un article ne doit pas reecrire un devis envoye.
  description String
  quantity    BigInt
  unitPrice   BigInt
  discountRate Int   @default(0)
  taxRateId   String?
  taxRate     Int    @default(0)
  lineTotal   BigInt @default(0)
  position    Int    @default(0)

  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxRateRef TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_lines")
}

/// Facture — document de creance unique de GestiOne.
///
/// Une vente au comptoir produit elle aussi une facture (`origin = "POS"`) :
/// c'est ce qui garantit qu'il n'existe **qu'un seul endroit** ou se calcule ce
/// que les clients doivent. Deux tables de creances finiraient toujours par
/// diverger, et le chiffre affiche au dirigeant serait faux.
model Invoice {
  id         String   @id @default(cuid())
  companyId  String
  number     String
  customerId String?
  locationId String?
  /// INVOICE | POS
  origin     String   @default("INVOICE")
  /// DRAFT | ISSUED | PARTIALLY_PAID | PAID | CANCELLED
  status     String   @default("DRAFT")
  issueDate  DateTime @default(now())
  dueDate    DateTime?

  subtotal       BigInt @default(0)
  discountAmount BigInt @default(0)
  discountRate   Int?
  taxTotal       BigInt @default(0)
  total          BigInt @default(0)
  /// Somme des paiements affectes, recalculee a chaque encaissement.
  paidAmount     BigInt @default(0)
  /// total - paidAmount, jamais negatif. Recalcule dans la meme transaction.
  balanceDue     BigInt @default(0)
  /// Cout d'achat total des lignes, fige a l'emission (marge des rapports).
  costTotal      BigInt @default(0)

  notes      String?
  terms      String?
  cancelledAt DateTime?
  cancelReason String?
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Partner?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  location Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines    InvoiceLine[]
  payments Payment[]
  quote    Quote?

  @@unique([companyId, number])
  @@index([companyId, status, issueDate])
  @@index([companyId, customerId, status])
  @@index([companyId, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    BigInt
  unitPrice   BigInt
  discountRate Int   @default(0)
  taxRateId   String?
  taxRate     Int    @default(0)
  /// Base taxable de la ligne, remise globale deduite.
  taxable     BigInt @default(0)
  taxAmount   BigInt @default(0)
  lineTotal   BigInt @default(0)
  /// Prix d'achat fige a l'emission : la marge historique ne doit pas bouger
  /// quand le prix d'achat de l'article change plus tard.
  unitCost    BigInt @default(0)
  position    Int    @default(0)

  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxRateRef TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_lines")
}

/// Reglement, client (encaissement) ou fournisseur (decaissement).
model Payment {
  id        String   @id @default(cuid())
  companyId String
  number    String
  /// IN = encaissement client, OUT = reglement fournisseur.
  direction String   @default("IN")
  partnerId String?
  invoiceId String?
  /// Commande fournisseur reglee, pour un decaissement.
  orderId   String?
  methodId  String?
  locationId String?

  amount    BigInt
  paidAt    DateTime @default(now())
  reference String?
  notes     String?
  userId    String?
  createdAt DateTime @default(now())

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner  Partner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  invoice  Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  order    PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  method   PaymentMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  location Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, paidAt])
  @@index([companyId, partnerId])
  @@index([invoiceId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Phase 5 — achats, depenses, caisse
// ---------------------------------------------------------------------------

/// Commande fournisseur, et **document de dette unique** de GestiOne.
///
/// Symetrique de `Invoice` cote clients : ce que l'entreprise doit a ses
/// fournisseurs se lit ici et nulle part ailleurs. Un achat direct (sans
/// commande prealable) est simplement une commande creee et receptionnee dans
/// la foulee.
model PurchaseOrder {
  id         String   @id @default(cuid())
  companyId  String
  number     String
  supplierId String?
  locationId String?
  /// DRAFT | ORDERED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  status     String   @default("DRAFT")
  orderDate  DateTime @default(now())
  expectedAt DateTime?
  dueDate    DateTime?

  subtotal       BigInt @default(0)
  discountAmount BigInt @default(0)
  taxTotal       BigInt @default(0)
  total          BigInt @default(0)
  /// Somme des reglements fournisseur affectes, recalculee a chaque paiement.
  paidAmount     BigInt @default(0)
  /// total - paidAmount, jamais negatif.
  balanceDue     BigInt @default(0)

  notes        String?
  reference    String?
  cancelledAt  DateTime?
  cancelReason String?
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Partner?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  user     User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines    PurchaseOrderLine[]
  payments Payment[]

  @@unique([companyId, number])
  @@index([companyId, status, orderDate])
  @@index([companyId, supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id          String @id @default(cuid())
  orderId     String
  productId   String?
  description String
  /// Quantite commandee, en milliemes d'unite.
  quantity    BigInt
  /// Quantite deja receptionnee. Une reception partielle est la norme.
  receivedQuantity BigInt @default(0)
  unitCost    BigInt
  discountRate Int   @default(0)
  taxRateId   String?
  taxRate     Int    @default(0)
  taxable     BigInt @default(0)
  taxAmount   BigInt @default(0)
  lineTotal   BigInt @default(0)
  position    Int    @default(0)

  order      PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxRateRef TaxRate?      @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("purchase_order_lines")
}

/// Categorie de depense, configurable par entreprise.
model ExpenseCategory {
  id        String   @id @default(cuid())
  companyId String
  name      String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("expense_categories")
}

/// Depense de fonctionnement : loyer, transport, salaires, electricite...
model Expense {
  id         String   @id @default(cuid())
  companyId  String
  number     String
  categoryId String?
  locationId String?
  supplierId String?
  methodId   String?

  amount      BigInt
  spentAt     DateTime @default(now())
  description String
  reference   String?
  /// Chemin du justificatif televerse, le cas echeant.
  receiptUrl  String?
  notes       String?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplier Partner?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  method   PaymentMethod?   @relation(fields: [methodId], references: [id], onDelete: SetNull)
  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, spentAt])
  @@index([companyId, categoryId])
  @@map("expenses")
}

/// Session de caisse : une ouverture, des mouvements, une fermeture comptee.
///
/// La session sert au **rapprochement** : elle compare ce que GestiOne a
/// enregistre a ce que le caissier a reellement compte. Elle ne conditionne pas
/// l'encaissement — refuser une vente parce qu'aucune session n'est ouverte
/// serait ingerable dans une boutique.
model CashSession {
  id         String   @id @default(cuid())
  companyId  String
  locationId String
  /// OPEN | CLOSED
  status     String   @default("OPEN")

  openedAt      DateTime  @default(now())
  openedById    String?
  /// Fonds de caisse au moment de l'ouverture.
  openingAmount BigInt    @default(0)

  closedAt       DateTime?
  closedById     String?
  /// Montant reellement compte a la fermeture.
  countedAmount  BigInt?
  /// Solde theorique a la fermeture : ouverture + mouvements.
  expectedAmount BigInt?
  /// countedAmount - expectedAmount. Negatif = manquant.
  difference     BigInt?
  closingNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location  Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  openedBy  User?          @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy  User?          @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  movements CashMovement[]

  @@index([companyId, locationId, status])
  @@index([companyId, openedAt])
  @@map("cash_sessions")
}

/// Mouvement de caisse. **Append-only**, comme le journal de stock.
///
/// `sessionId` est facultatif : un encaissement en especes hors session reste
/// enregistre, et le solde de caisse d'un point de vente est la somme de tous
/// ses mouvements, avec ou sans session. Sinon, l'argent encaisse pendant
/// qu'aucune session n'est ouverte disparaitrait des comptes.
model CashMovement {
  id         String   @id @default(cuid())
  companyId  String
  locationId String
  sessionId  String?

  /// OPENING | SALE | REFUND | EXPENSE | PURCHASE | DEPOSIT | WITHDRAWAL | ADJUSTMENT
  kind      String
  /// Variation signee, en unite mineure : positive en entree, negative en sortie.
  amount    BigInt
  reason    String?
  reference String?
  paymentId String?
  expenseId String?
  userId    String?
  createdAt DateTime @default(now())

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  session  CashSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, locationId, createdAt])
  @@index([sessionId])
  @@index([paymentId])
  @@map("cash_movements")
}
