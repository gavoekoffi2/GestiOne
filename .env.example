# Connexion PostgreSQL principale
DATABASE_URL="postgresql://user:password@localhost:5432/gestione?schema=public"
# Base utilisee par la suite de tests (elle est reinitialisee a chaque execution)
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/gestione_test?schema=public"
# Nom du cookie de session
SESSION_COOKIE_NAME="gestione_session"
